# Neon Postgres connection (pgvector-enabled)
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/invoicegen?sslmode=require

# OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3-8b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Dimensions must match the pgvector column definition in the database.
EMBEDDING_DIMENSIONS=1024

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# JWT authentication (HS256). Must match the values the C# InvoiceGen backend
# uses to sign the tokens it issues to users.
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
