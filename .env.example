# Neon Postgres connection (pgvector-enabled)
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/invoicegen?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensions must match the pgvector column definition in the database.
OPENAI_EMBEDDING_DIMENSIONS=1536

# Service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
